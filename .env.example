# Real sold prices and property records (lib/data): a RentCast API key from app.rentcast.io.
# Left empty, every result is a demo built on made-up sales, and says so.
RENTCAST_API_KEY=
# RentCast has no hard cap and charges for every request past the plan's monthly number, so flip
# keeps its own budget: this many requests in any 31 days in a row, everyone together, and at most
# so many of them caused by one person. Both optional: these are the defaults, sized for the free
# plan's 50 a month with ten left over for requests made elsewhere with the same key (by hand, or
# by another copy of the app): this count does not see those. On the $74 plan (1,000 a month) set
# the first to about 950. FLIP_RENTCAST_REQUESTS=0 switches real data off without removing the key.
# Set the key on Production only.
FLIP_RENTCAST_REQUESTS=40
FLIP_RENTCAST_PER_PERSON=30

# Claude vision for photo assessment (lib/vision). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Clerk: `npx clerk@latest init --framework next -y` writes these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Postgres (Neon). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Usage limits (lib/usage/limits.ts). All optional: these are the defaults.
# A full analysis costs AI money, so each person gets a monthly allowance and
# a short-window rate limit, and everyone together a daily ceiling. Set
# FLIP_MONTHLY_ANALYSES or FLIP_DAILY_ANALYSES_ALL to 0 to switch analyses off.
FLIP_MONTHLY_ANALYSES=40
FLIP_ANALYSES_PER_10_MIN=6
FLIP_ATTEMPTS_PER_10_MIN=30
FLIP_QUICK_PER_10_MIN=60
FLIP_DAILY_ANALYSES_ALL=150

# The deal finder's map background (/app/find). A free CARTO key (carto.com) gives CARTO's Voyager map, free for
# commercial use up to a million tiles a month by CARTO's terms. Without one, OpenStreetMap's own tiles, which its
# policy allows for light use and may withdraw. MAP_TILES=off shows the pins alone.
MAP_TILES_CARTO_KEY=
