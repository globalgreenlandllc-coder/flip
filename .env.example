# Which SalesProvider/ParcelProvider to use. "synthetic" until King County is loaded.
DATA_PROVIDER=synthetic

# Claude vision for photo assessment (lib/vision). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Clerk: `npx clerk@latest init --framework next -y` writes these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Postgres (Neon). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
