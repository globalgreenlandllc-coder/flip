# Which SalesProvider/ParcelProvider to use. "synthetic" until King County is loaded.
DATA_PROVIDER=synthetic

# Claude vision for photo assessment (lib/vision). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Clerk: `npx clerk@latest init --framework next -y` writes these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Postgres (Neon). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Usage limits (lib/usage/limits.ts). All optional: these are the defaults.
# A full analysis costs AI money, so each person gets a monthly allowance and
# a short-window rate limit, and everyone together a daily ceiling. Set
# FLIP_MONTHLY_ANALYSES or FLIP_DAILY_ANALYSES_ALL to 0 to switch analyses off.
FLIP_MONTHLY_ANALYSES=40
FLIP_ANALYSES_PER_10_MIN=6
FLIP_ATTEMPTS_PER_10_MIN=30
FLIP_QUICK_PER_10_MIN=60
FLIP_DAILY_ANALYSES_ALL=150
