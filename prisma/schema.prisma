// Postgres everywhere (Neon via the Vercel marketplace). DATABASE_URL is the
// pooled connection for the app; DATABASE_URL_UNPOOLED runs migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Deal {
  id          String   @id @default(cuid())
  userId      String
  createdAt   DateTime @default(now())
  title       String
  source      String?
  askingPrice Float
  verdict     String
  arv         Float
  maxOffer    Float
  profit      Float
  /// Where the market data behind the numbers came from. "synthetic" or empty = demo numbers (lib/data isDemoProvider).
  provider    String?
  /// JSON: { report, plan?, assessment?, listing?, provider? }
  payload     String

  @@index([userId, createdAt])
}

/// One run of a full analysis or of Quick Numbers. This is what the
/// per-person limits count (lib/usage/limits.ts), and the record of what each
/// analysis cost in AI tokens.
model UsageRun {
  id           String   @id @default(cuid())
  userId       String
  createdAt    DateTime @default(now())
  /// "analyze" (photos + AI) or "quick" (numbers only)
  kind         String
  /// "started" | "ok" | "failed" (the AI answered, then something went wrong) | "free" (no answer from the AI: not paid for).
  /// A run turned away by a limit leaves no row.
  status       String   @default("started")
  /// Host of the listing site the run started from, if any.
  source       String?
  photos       Int      @default(0)
  /// AI model that read the photos, and what it used.
  model        String?
  inputTokens  Int?
  outputTokens Int?
  /// Wall-clock time of the whole run.
  ms           Int?

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// One request to a paid data provider (RentCast). This is what flip's own
/// request budget counts (lib/data/budget.ts): the provider has no cap of its
/// own and charges for every request past the plan's number.
model DataRequest {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// "rentcast"
  provider   String
  /// "property" (one address) or "sales" (the sold homes around a point)
  kind       String
  /// Who caused it (the signed-in person). Empty for a script.
  userId     String?
  /// "started" | "billed" (answered 200) | "unknown" (no answer came back: counted as billed) |
  /// "free" (answered with another status, which is not billed). A request the budget refused leaves no row.
  status     String   @default("started")
  httpStatus Int?
  /// Records in the answer.
  results    Int?
  ms         Int?

  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

/// What a data provider answered, kept so the same question is not paid for
/// twice. `payload` is already reduced to the fields flip uses (lib/data/rentcast.ts
/// PropertyRecord): never an owner's name or mailing address.
model DataCache {
  key       String   @id
  provider  String
  fetchedAt DateTime
  expiresAt DateTime
  /// JSON
  payload   String

  @@index([expiresAt])
}
