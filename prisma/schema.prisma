// Postgres everywhere (Neon via the Vercel marketplace). DATABASE_URL is the
// pooled connection for the app; DATABASE_URL_UNPOOLED runs migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Deal {
  id          String   @id @default(cuid())
  userId      String
  createdAt   DateTime @default(now())
  title       String
  source      String?
  askingPrice Float
  verdict     String
  arv         Float
  maxOffer    Float
  profit      Float
  /// Where the market data behind the numbers came from. "synthetic" or empty = demo numbers (lib/data isDemoProvider).
  provider    String?
  /// JSON: { report, plan?, assessment?, listing?, provider? }
  payload     String

  @@index([userId, createdAt])
}

/// One run of a full analysis or of Quick Numbers. This is what the
/// per-person limits count (lib/usage/limits.ts), and the record of what each
/// analysis cost in AI tokens.
model UsageRun {
  id           String   @id @default(cuid())
  userId       String
  createdAt    DateTime @default(now())
  /// "analyze" (photos + AI) or "quick" (numbers only)
  kind         String
  /// "started" | "ok" | "failed" (the AI answered, then something went wrong) | "free" (no answer from the AI: not paid for).
  /// A run turned away by a limit leaves no row.
  status       String   @default("started")
  /// Host of the listing site the run started from, if any.
  source       String?
  photos       Int      @default(0)
  /// AI model that read the photos, and what it used.
  model        String?
  inputTokens  Int?
  outputTokens Int?
  /// Wall-clock time of the whole run.
  ms           Int?

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// One request to a paid data provider (RentCast). This is what flip's own
/// request budget counts (lib/data/budget.ts): the provider has no cap of its
/// own and charges for every request past the plan's number.
model DataRequest {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// "rentcast"
  provider   String
  /// "property" (one address) or "sales" (the sold homes around a point)
  kind       String
  /// Who caused it (the signed-in person). Empty for a script.
  userId     String?
  /// "started" | "billed" (answered 200) | "unknown" (no answer came back: counted as billed) |
  /// "free" (answered with another status, which is not billed). A request the budget refused leaves no row.
  status     String   @default("started")
  httpStatus Int?
  /// Records in the answer.
  results    Int?
  ms         Int?

  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

/// One page seen, for the admin page's numbers, map and Traffic view (lib/visits/visit.ts has the rules). No internet
/// address and no cookie: `visitor` is a one-way fingerprint made with a random key of the day that is deleted when the
/// day is over, so a visitor who is not signed in is counted once a day and cannot be followed from one day to the
/// next. A signed-in person's visits keep their account (`userId`), on the owner's choice of 2026-11-27, so the admin
/// Traffic view can say who did what. Kept 400 days.
model Visit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// The page's path: no query string, an id in it written "[id]".
  path      String
  /// The day's fingerprint (32 hex characters).
  visitor   String
  /// The same for the internet address alone, only to cap one address's pages in a day.
  source    String
  /// The owner (an admin) was signed in: their visits are left out of the numbers.
  own       Boolean  @default(false)
  /// Someone was signed in.
  signedIn  Boolean  @default(false)
  /// The signed-in person's account (Clerk user id). Only when signed in; never for a visitor who is not.
  userId    String?
  /// "phone", "tablet" or "computer", read from the browser's name; the browser's name itself is never kept.
  device    String?
  /// A short name for the browser or app: "Safari", "Chrome", "Facebook app"…
  browser   String?
  /// The link's campaign tags (utm_*), on the first page of a visit only, short and cleaned. The rest of the query
  /// string is never kept.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  /// The network whose click id the link carried ("facebook" for fbclid, "google" for gclid…): never the id.
  clickFrom String?
  /// The link carried a click id only paid ads get (gclid, msclkid, ttclid…; not Facebook's fbclid, which Facebook
  /// adds to every link): only that it did, never the id.
  adClick   Boolean  @default(false)
  /// Host of the site the visitor came from, when it was another site.
  referrer  String?
  /// What Vercel reads from the internet address: the country (ISO 3166), the region's code, the city, and the
  /// middle of that city rounded to two places (about a kilometre).
  country   String?
  region    String?
  city      String?
  lat       Float?
  lng       Float?

  @@index([createdAt])
  @@index([visitor])
  @@index([source])
  @@index([userId])
}

/// What a data provider answered, kept so the same question is not paid for
/// twice. `payload` is already reduced to the fields flip uses (lib/data/rentcast.ts
/// PropertyRecord): never an owner's name or mailing address.
model DataCache {
  key       String   @id
  provider  String
  fetchedAt DateTime
  expiresAt DateTime
  /// JSON
  payload   String

  @@index([expiresAt])
}
