// Postgres everywhere (Neon via the Vercel marketplace). DATABASE_URL is the
// pooled connection for the app; DATABASE_URL_UNPOOLED runs migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Deal {
  id          String   @id @default(cuid())
  userId      String
  createdAt   DateTime @default(now())
  title       String
  source      String?
  askingPrice Float
  verdict     String
  arv         Float
  maxOffer    Float
  profit      Float
  /// JSON: { report, plan?, assessment?, listing? }
  payload     String

  @@index([userId, createdAt])
}
